rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'intmedweb@gmail.com' && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Stories Collection
    match /stories/{storyId} {
      // Anyone can read approved/published stories
      allow read: if isValidId(storyId);
      
      // Admin only can create or update stories
      allow write: if isAdmin() && isValidId(storyId);

      // Narrations subcollection
      match /narrations/{narrationId} {
        allow read: if isValidId(narrationId) && (
          resource.data.publicationStatus == 'PUBLISHED' ||
          (isSignedIn() && resource.data.narratorId == request.auth.uid) ||
          isAdmin()
        );

        allow create: if isSignedIn() && isValidId(narrationId) &&
          request.resource.data.narratorId == request.auth.uid &&
          request.resource.data.consentStatus is string &&
          request.resource.data.isChildRecording != true; // Child recordings are kept private on client by default

        allow update, delete: if isSignedIn() && (
          resource.data.narratorId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // User Progress & Private Reading Logs
    match /users/{userId}/progress {
      allow read, write: if isOwner(userId) && isValidId(userId);
    }
  }
}
